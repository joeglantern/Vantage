# Local development only. Never put production values in any committed file.
# Production M-Pesa credentials exist only in production, supplied at runtime.
# See docs/05-security.md#credential-custody and docs/09 sandbox discipline.

DATABASE_URL="postgresql://vantage:vantage@localhost:5433/vantage?schema=public"
SHADOW_DATABASE_URL="postgresql://vantage:vantage@localhost:5433/vantage_shadow?schema=public"
REDIS_URL="redis://localhost:6380"

NODE_ENV="development"
LOG_LEVEL="debug"

# Envelope-encryption master key, supplied at process start. Never committed and
# never in the database. Generate a local one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In production this comes from a systemd credential, a KMS, or an operator at
# start-up, and it never touches a file. See docs/05 credential custody.
VANTAGE_MASTER_KEY_ID="local-dev-1"
VANTAGE_MASTER_KEY=""

# Daraja sandbox credentials for local development. Real values go in .env,
# which is gitignored. Never commit a value here, and never point a development
# environment at a production shortcode (docs/09 sandbox discipline).
DARAJA_ENV="sandbox"
DARAJA_BASE_URL="https://sandbox.safaricom.co.ke"
DARAJA_CONSUMER_KEY=""
DARAJA_CONSUMER_SECRET=""
